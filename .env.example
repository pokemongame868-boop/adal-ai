# ADAL AI — server-side configuration. Copy to .env and fill in real values.
# NEVER commit .env. All variables are read only by the Node server (no VITE_ prefix), never by the browser.

# ── AI: OpenRouter (default when OPENROUTER_API_KEY is set) ──
# Key from https://openrouter.ai/settings/keys. Leave empty here; set it in .env or host secrets.
OPENROUTER_API_KEY=
# Optional (defaults shown):
# OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free
# OPENROUTER_TIMEOUT_MS=45000
# OPENROUTER_MAX_RETRIES=2                     # retries on 429 / 5xx only
# OPENROUTER_MAX_RETRY_DELAY_MS=10000          # longer Retry-After => fail fast
# OPENROUTER_MAX_CONCURRENCY=2                 # simultaneous requests (free: 20 req/min)
# OPENROUTER_MAX_QUEUE=20
# OPENROUTER_MAX_TOKENS=3000                   # reasoning model: includes reasoning tokens
# OPENROUTER_TEMPERATURE=0.4
# OPENROUTER_APP_URL=https://your-site.example # optional attribution (HTTP-Referer)
# AI_PROVIDER=aihubmix                         # force AIHubMix even if OPENROUTER_API_KEY is set

# ── AI: AIHubMix (OpenAI-compatible gateway, https://aihubmix.com/v1/chat/completions) ──
# Inference API key from https://console.aihubmix.com → API Keys (not an account-management key).
AIHUBMIX_ACCESS_KEY=your_api_key_here
# A chat model id copied from https://aihubmix.com/models (must support /v1/chat/completions).
AIHUBMIX_MODEL=your_available_model_id

# ── Database: Supabase (only used to store feedback suggestions) ──
SUPABASE_URL=your_supabase_project_url
# Public anon key or the newer publishable key (sb_publishable_...). RLS limits it to INSERT on feedback.
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
# SUPABASE_SERVICE_ROLE_KEY is NOT needed by ADAL. Never put it here or in frontend code.

# ── Optional tuning ──
# AIHUBMIX_BASE_URL=https://aihubmix.com/v1     # backup host: https://api.inferera.com/v1
# AIHUBMIX_TIMEOUT_MS=45000
# AIHUBMIX_MAX_TOKENS=1400
# AIHUBMIX_TEMPERATURE=0.4                      # "default" = don't send temperature
# PORT=8787
# RATE_LIMIT_PER_MIN=20                         # per IP for /api/chat and /api/complaint
# FEEDBACK_RATE_LIMIT_PER_MIN=3                 # per IP for /api/feedback
